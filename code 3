// Fire Detection Rover

#define RIGHT_FIRE_SENSOR 1   // IO1
#define LEFT_FIRE_SENSOR  2   // IO2

// Motor Pins
#define M1_F 32
#define M1_R 33

#define M2_F 25
#define M2_R 26

#define M3_F 27
#define M3_R 14

#define M4_F 12
#define M4_R 13

void setup() {
  Serial.begin(115200);

  pinMode(RIGHT_FIRE_SENSOR, INPUT);
  pinMode(LEFT_FIRE_SENSOR, INPUT);

  pinMode(M1_F, OUTPUT);
  pinMode(M1_R, OUTPUT);

  pinMode(M2_F, OUTPUT);
  pinMode(M2_R, OUTPUT);

  pinMode(M3_F, OUTPUT);
  pinMode(M3_R, OUTPUT);

  pinMode(M4_F, OUTPUT);
  pinMode(M4_R, OUTPUT);

  stopRobot();
}

void loop() {

  int rightFire = digitalRead(RIGHT_FIRE_SENSOR);
  int leftFire  = digitalRead(LEFT_FIRE_SENSOR);

  Serial.print("Right: ");
  Serial.print(rightFire);
  Serial.print("  Left: ");
  Serial.println(leftFire);

  // Most flame sensors give LOW when fire is detected

  if (rightFire == LOW && leftFire == LOW) {
    moveForward();      // Fire straight ahead
  }

  else if (rightFire == LOW && leftFire == HIGH) {
    turnRight();        // Fire on right side
  }

  else if (rightFire == HIGH && leftFire == LOW) {
    turnLeft();         // Fire on left side
  }

  else {
    stopRobot();        // No fire detected
  }

  delay(100);
}

// =====================
// Motor Functions
// =====================

void moveForward() {

  digitalWrite(M1_F, HIGH);
  digitalWrite(M1_R, LOW);

  digitalWrite(M2_F, HIGH);
  digitalWrite(M2_R, LOW);

  digitalWrite(M3_F, HIGH);
  digitalWrite(M3_R, LOW);

  digitalWrite(M4_F, HIGH);
  digitalWrite(M4_R, LOW);
}

void turnLeft() {

  digitalWrite(M1_F, LOW);
  digitalWrite(M1_R, HIGH);

  digitalWrite(M2_F, LOW);
  digitalWrite(M2_R, HIGH);

  digitalWrite(M3_F, HIGH);
  digitalWrite(M3_R, LOW);

  digitalWrite(M4_F, HIGH);
  digitalWrite(M4_R, LOW);
}

void turnRight() {

  digitalWrite(M1_F, HIGH);
  digitalWrite(M1_R, LOW);

  digitalWrite(M2_F, HIGH);
  digitalWrite(M2_R, LOW);

  digitalWrite(M3_F, LOW);
  digitalWrite(M3_R, HIGH);

  digitalWrite(M4_F, LOW);
  digitalWrite(M4_R, HIGH);
}

void stopRobot() {

  digitalWrite(M1_F, LOW);
  digitalWrite(M1_R, LOW);

  digitalWrite(M2_F, LOW);
  digitalWrite(M2_R, LOW);

  digitalWrite(M3_F, LOW);
  digitalWrite(M3_R, LOW);

  digitalWrite(M4_F, LOW);
  digitalWrite(M4_R, LOW);
}
